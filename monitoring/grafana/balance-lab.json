{
  "uid": "balance-lab",
  "title": "Balance Lab · application and infrastructure",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["balance-lab"],
  "timezone": "utc",
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Scrape targets (1 = up)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "up", "legendFormat": "{{job}} / {{instance}}"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "HTTP request rate · excludes monitoring polls / actuator", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"balance-app\",uri!~\"/actuator.*|/api/monitoring\"}[2m]))", "legendFormat": "HTTP {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "HTTP p95 latency · 2m · all replicas", "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"balance-app\",uri!~\"/actuator.*|/api/monitoring\"}[2m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "JVM heap by app instance", "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"balance-app\",area=\"heap\"})", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "JDBC pool · active connections", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "hikaricp_connections_active{job=\"balance-app\"}", "legendFormat": "{{instance}} / {{pool}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 6, "type": "timeseries", "title": "Outbox backlog · shared queue (max, not sum)", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(balance_kafka_outbox_pending{job=\"balance-app\"})", "legendFormat": "Pending events"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "Outbox publish / failure rate", "gridPos": {"x": 0, "y": 21, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(balance_kafka_outbox_published_total{job=\"balance-app\"}[2m]))", "legendFormat": "Published / s"}, {"refId": "B", "expr": "sum(rate(balance_kafka_outbox_failures_total{job=\"balance-app\"}[2m]))", "legendFormat": "Failures / s"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 8, "type": "text", "title": "Reading these charts", "gridPos": {"x": 12, "y": 21, "w": 12, "h": 7}, "options": {"mode": "markdown", "content": "Scrapes run every 15 seconds. Rates use a 2-minute window; wait for at least two scrapes. Empty data is unknown, not zero. HTTP includes console polling. Docker panels use cAdvisor; Kubernetes panels use namespace-scoped kube-state-metrics. The other platform's panels will be empty. Infrastructure observations do not prove financial correctness or Kafka consumer delivery. This stack does not collect logs, traces, Docker healthchecks, or Kubernetes container CPU/memory usage."}},
    {"id": 9, "type": "timeseries", "title": "Docker · container CPU cores", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (service, name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",service!=\"\"}[2m]))", "legendFormat": "{{service}} / {{name}}"}], "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "Docker · container working memory", "gridPos": {"x": 12, "y": 28, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (service, name) (container_memory_working_set_bytes{job=\"cadvisor\",service!=\"\"})", "legendFormat": "{{service}} / {{name}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}},
    {"id": 11, "type": "timeseries", "title": "Kubernetes · pod readiness", "gridPos": {"x": 0, "y": 35, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "kube_pod_status_ready{job=\"kube-state-metrics\",condition=\"true\"}", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}},
    {"id": 12, "type": "timeseries", "title": "Kubernetes · container restarts", "gridPos": {"x": 12, "y": 35, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (pod) (kube_pod_container_status_restarts_total{job=\"kube-state-metrics\"})", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 13, "type": "timeseries", "title": "Kubernetes · Deployment replicas", "gridPos": {"x": 0, "y": 42, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "kube_deployment_spec_replicas{job=\"kube-state-metrics\"}", "legendFormat": "{{deployment}} desired"}, {"refId": "B", "expr": "kube_deployment_status_replicas_available{job=\"kube-state-metrics\"}", "legendFormat": "{{deployment}} available"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 14, "type": "timeseries", "title": "Kubernetes · StatefulSet replicas", "gridPos": {"x": 12, "y": 42, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "kube_statefulset_replicas{job=\"kube-state-metrics\"}", "legendFormat": "{{statefulset}} desired"}, {"refId": "B", "expr": "kube_statefulset_status_replicas_ready{job=\"kube-state-metrics\"}", "legendFormat": "{{statefulset}} ready"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}}
  ]
}
